<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1C1C1E"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="라벨 편집"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAiTagsStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="🤖 AI 태그: 분석 중..."
        android:textColor="#8E8E93"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvAiCaptionStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text=""
        android:textColor="#8E8E93"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/labelListContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvNoLabels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="아직 추가된 라벨이 없어요."
        android:textColor="#8E8E93"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etNewLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="새 라벨 입력"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#8E8E93" />

        <TextView
            android:id="@+id/btnAddLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:padding="8dp"
            android:text="추가"
            android:textColor="#0A84FF"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnCloseLabelDialog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:padding="10dp"
        android:text="완료"
        android:textColor="#0A84FF"
        android:textStyle="bold" />

</LinearLayout>
